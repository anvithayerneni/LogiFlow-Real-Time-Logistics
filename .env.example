# ==============================================================================
# Real-Time Delivery & Logistics Platform - Environment Configuration Template
# ==============================================================================

# Application Environment (development | staging | production | test)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
PROJECT_NAME="Real-Time Delivery & Logistics Platform"
API_V1_PREFIX=/api/v1
SECRET_KEY=super-secret-key-change-in-production-min-32-chars-long!!
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database (PostgreSQL / SQLite Dual Engine)
# For local Docker Compose / PostgreSQL:
DATABASE_URL=postgresql+asyncpg://logistics_user:logistics_pass@localhost:5432/logistics_db
# For lightweight local standalone dev without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./logistics.db

# Cache & Geospatial Store (Redis)
REDIS_URL=redis://localhost:6379/0

# Event Streaming (Apache Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=delivery-logistics-backend

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Observability (Prometheus & Grafana)
PROMETHEUS_METRICS_PORT=8000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
